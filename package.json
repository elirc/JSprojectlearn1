{
  "name": "skillforge-quest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A gamified, persistent software-engineering learning journey.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:watch": "vitest",
